# Copy to /etc/ai-agency/production.env on the VPS and edit the non-secret values.
API_DOMAIN=api.example.com
N8N_DOMAIN=automation.example.com
CERTBOT_EMAIL=ops@example.com
SECRETS_DIR=/etc/ai-agency/secrets
LETSENCRYPT_DIR=/etc/letsencrypt

API_IMAGE=ghcr.io/your-org/ai-agency-api:replace-with-immutable-image-tag
N8N_IMAGE=n8nio/n8n:latest@sha256:9a8d8dcea75667496695d7810d7e1fe018a65efb36cc499d347f3931b3957b5d

POSTGRES_ADMIN_USER=platform_admin
APP_DB_NAME=ai_agency
APP_DB_USER=ai_agency_app
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
GRAFANA_ADMIN_USER=admin

OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2026-03-11
NOTION_TIMEOUT_MS=15000
WHATSAPP_ALLOWED_RECIPIENT=

PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
DOCKER_LOG_DIR=/var/lib/docker/containers
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_RETENTION=15d
