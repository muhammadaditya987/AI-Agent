# Store as /etc/ai-agency/backup.env with mode 0600; never commit live values.
RESTIC_REPOSITORY=s3:your-bucket/ai-agency/production
RESTIC_PASSWORD_FILE=/etc/ai-agency/restic-password
S3_ENDPOINT=https://s3.example.com
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
