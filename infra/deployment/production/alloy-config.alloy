local.file_match "docker" {
  path_targets = [
    {
      "__path__" = "/var/lib/docker/containers/*/*-json.log",
      "job"      = "docker",
    },
  ]
}

loki.source.file "docker" {
  targets       = local.file_match.docker.targets
  forward_to    = [loki.process.docker.receiver]
  tail_from_end = true
}

loki.process "docker" {
  forward_to = [loki.write.production.receiver]

  stage.json {
    expressions = {
      attrs = "",
    }
  }

  stage.docker {}

  stage.json {
    expressions = {
      tag = "",
    }
    source = "attrs"
  }

  stage.labels {
    values = {
      container = "tag",
    }
  }
}

loki.write "production" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
