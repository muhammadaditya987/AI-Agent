{
  "name": "AI Content Factory - Sprint 2",
  "nodes": [
    {
      "parameters": {
        "formTitle": "AI Content Factory",
        "formDescription": "Buat satu project lagu anak. WhatsApp hanya dibuat sebagai preview pada Sprint 2; tidak ada pesan yang dikirim.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Keyword",
              "fieldName": "keyword",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Target Usia",
              "fieldName": "targetAge",
              "fieldType": "text",
              "placeholder": "Contoh: 2-5 tahun",
              "requiredField": true
            },
            {
              "fieldLabel": "Bahasa",
              "fieldName": "language",
              "fieldType": "text",
              "defaultValue": "Indonesia",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Buat project"
        }
      },
      "id": "ef0a1a5d-1286-46ce-a0be-42da9b376508",
      "name": "AI Content Factory Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:3000/api/v1/internal/content-factory/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { keyword: $('AI Content Factory Form').first().json.keyword, targetAge: $('AI Content Factory Form').first().json.targetAge, language: $('AI Content Factory Form').first().json.language } }}",
        "options": {
          "timeout": 100000
        }
      },
      "id": "bb4236e2-ad91-40b9-bd21-7d028951a1e2",
      "name": "Generate Content Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:3000/api/v1/internal/notion/projects",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { brief: { keyword: $('AI Content Factory Form').first().json.keyword, targetAge: $('AI Content Factory Form').first().json.targetAge, language: $('AI Content Factory Form').first().json.language }, assets: $('Generate Content Assets').first().json.data.assets } }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "80242ccd-0f65-469e-8b92-98f363c94642",
      "name": "Save Project to Notion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const brief = $('AI Content Factory Form').first().json;\nconst assets = $('Generate Content Assets').first().json.data.assets;\nconst notion = $('Save Project to Notion').first().json.data;\nreturn [{ json: { eventType: 'project_ready', title: assets.title, duration: assets.estimatedDuration, keyword: brief.keyword, notionUrl: notion.pageUrl } }];"
      },
      "id": "661b6ed0-6588-4ed1-b558-966eb189cbad",
      "name": "Prepare Success Notification Preview",
