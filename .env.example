# Local development only. Copy to .env and replace every value.
# Do not use these values for staging or production.

POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=replace_with_local_admin_password
APP_DB_NAME=ai_agency
APP_DB_USER=ai_agency_app
APP_DB_PASSWORD=replace_with_local_app_password
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=replace_with_local_n8n_db_password

REDIS_PASSWORD=replace_with_local_redis_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Use a cryptographically random value of at least 32 characters.
# Keep it stable for the lifetime of the n8n encryption store.
N8N_ENCRYPTION_KEY=replace_with_random_key_at_least_32_characters
N8N_IMAGE=n8nio/n8n:latest@sha256:9a8d8dcea75667496695d7810d7e1fe018a65efb36cc499d347f3931b3957b5d
AUTOMATION_SHARED_TOKEN=replace_with_random_value_at_least_32_characters

# Sprint 2 AI Content Factory. Keep secrets in local .env, never commit them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=90000
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2026-03-11
NOTION_TIMEOUT_MS=15000

# WhatsApp is deliberately dry-run only in Sprint 2; no provider request is made.
WHATSAPP_DRY_RUN=true
WHATSAPP_ALLOWED_RECIPIENT=replace_with_approved_indonesian_mobile_number

API_PORT=3000
N8N_PORT=5678
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_local_grafana_password
